---
import { siteConfig } from '../config/site';
---

<footer class="site-footer">
  <div class="footer-contact">
    <p class="eyebrow">Contact</p>
    <h2>Let’s build something thoughtful.</h2>
    <p>Have a role or a project in mind? I’d love to talk about backend development, automation, and software quality.</p>
    {siteConfig.email && <a class="contact-link" href={`mailto:${siteConfig.email}`}>Let’s connect by email <span aria-hidden="true">↗</span></a>}
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {siteConfig.name} · {siteConfig.handle}</p>
    <nav aria-label="Footer navigation">
      <a href="/work/">Work</a><a href="/about/">About</a><a href="/resume/">Résumé</a>
      {siteConfig.github && <a href={siteConfig.github} rel="me">GitHub <span aria-hidden="true">↗</span></a>}
    </nav>
  </div>
</footer>
