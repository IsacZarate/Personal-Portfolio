---
import developerArtwork from '../assets/developer.svg';
import EmptyWorkState from '../components/EmptyWorkState.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import QualitySequence from '../components/QualitySequence';
import SkillsConstellation from '../components/SkillsConstellation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../config/resume';
import { getPublishedProjects } from '../lib/projects';
const projects = await getPublishedProjects();
---

<BaseLayout title="Backend Engineer / SDET" description="Isac Zarate, TheDevIsacZ — Backend Engineer / SDET with skills in Java, Python, REST API development, automation, and software testing." pathname="/">
  <section class="hero" aria-labelledby="hero-heading">
    <p class="hero-greeting">
      <svg class="greeting-arrow" viewBox="0 0 80 70" fill="none" aria-hidden="true"><path d="M77 3C43 0 8 27 8 60m-5-9 5 10 11-7" stroke="currentColor" stroke-linecap="round"/></svg>
      Hello! I’m <span>Isac Zarate.</span>
    </p>
    <div class="hero-grid">
      <div class="hero-art"><img src={developerArtwork.src} width="320" height="320" alt="" fetchpriority="high" /></div>
      <div class="hero-content">
        <p class="eyebrow">TheDevIsacZ · Software engineering</p>
        <h1 id="hero-heading"><span class="role-line">Backend Engineer</span> <span>/ <span class="circled">SDET</span></span></h1>
        <p class="hero-copy">Thoughtful code. Thorough testing.<br />I work across application development, API-based systems, and software quality.</p>
        <div class="button-row"><a class="button button-primary" href="/resume/">View résumé <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/work/">Explore work <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
    <div class="intro-note">
      <h2>Curiosity in the code. Confidence in the details.</h2>
      <p class="current-role">Currently, I’m an {resume.experience.title} at <span>{resume.experience.company}.</span></p>
      <p>Java and Python are at the center of my work. I enjoy understanding how systems fit together, investigating issues, and helping make software more reliable—from implementation through testing.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-heading" data-reveal>
    <div class="section-heading"><p class="eyebrow">A little of my background</p><h2 id="experience-heading">Experience &amp; focus.</h2></div>
    <div class="experience-grid">
      <article class="experience-card">
        <FeatureIcon kind="work" />
        <div><p class="eyebrow">Work experience</p><h3>{resume.experience.title} · {resume.experience.company}</h3><p class="card-meta">{resume.experience.dates}</p><p>Application updates, code review, software validation, testing, and documentation.</p><a class="text-link" href="/resume/#experience-heading">View experience <span aria-hidden="true">→</span></a></div>
      </article>
      <article class="experience-card">
        <FeatureIcon kind="education" />
        <div><p class="eyebrow">Education</p><h3>Computer Science · CSU Channel Islands</h3><p class="card-meta">B.S. · Expected {resume.education.expectedGraduation}</p><p>Studying computer science while gaining hands-on experience in software development and testing.</p><a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a></div>
      </article>
      <article class="experience-card">
        <FeatureIcon kind="code" />
        <div><p class="eyebrow">Development focus</p><h3>Building the pieces that connect.</h3><p class="card-meta">Java · Python · REST APIs</p><p>Full-stack development, API-based systems, data pipelines, debugging, and troubleshooting.</p></div>
      </article>
      <article class="experience-card">
        <FeatureIcon kind="shield" />
        <div><p class="eyebrow">Quality focus</p><h3>Making room for the edge cases.</h3><p class="card-meta">Selenium · Postman · GitHub Actions</p><p>Test automation, API testing, functional and regression testing, and clear test documentation.</p></div>
      </article>
    </div>
  </section>

  <section class="section skills-section" aria-labelledby="skills-heading" data-reveal>
    <div class="section-heading"><p class="eyebrow">My toolkit</p><h2 id="skills-heading">Different tools.<br /><span>One connected approach.</span></h2><p>Development, testing, and delivery—working together.</p></div>
    <SkillsConstellation />
  </section>

  <section class="section work-section" aria-labelledby="work-heading" data-reveal>
    <div class="section-heading section-heading-row"><div><p class="eyebrow">Selected work</p><h2 id="work-heading">A closer look at the work.</h2></div><a class="text-link" href="/work/">Explore work <span aria-hidden="true">↗</span></a></div>
    {projects.length === 0 ? <EmptyWorkState /> : (
      <div class="project-list">{projects.map((project) => (
        <article class="project-card"><p class="eyebrow">{project.data.role}</p><h3><a href={`/work/${project.data.slug}/`}>{project.data.title}</a></h3><p>{project.data.summary}</p></article>
      ))}</div>
    )}
  </section>

  <section class="section technical-panel" aria-labelledby="quality-heading" data-reveal>
    <div class="section-grid"><div><p class="eyebrow">How I approach quality</p><h2 id="quality-heading">Good software deserves<br />a second look.</h2><p class="fine-print">The workflow behind this portfolio.</p></div><QualitySequence client:visible /></div>
  </section>
</BaseLayout>
