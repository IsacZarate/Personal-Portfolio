---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasResumePdf, siteConfig } from '../config/site';
import { resume } from '../config/resume';
---

<BaseLayout title="Résumé" description="Isac Zarate’s Backend Engineer / SDET résumé: VivoSense internship, Computer Science education, technical skills, and ClassSeek project." pathname="/resume/">
  <header class="page-intro">
    <p class="eyebrow">Résumé</p>
    <h1>Isac Zarate <span aria-hidden="true">/</span> TheDevIsacZ</h1>
    <p class="lede">{resume.headline}</p>
    {hasResumePdf(siteConfig) ? (
      <div class="button-row">
        <a class="button button-primary" href={siteConfig.resume.pdfPath}>View résumé PDF</a>
        <a class="button button-secondary" href={siteConfig.resume.pdfPath} download="isac-zarate-resume.pdf">Download résumé PDF</a>
      </div>
    ) : <p class="notice" role="note">Read the résumé below. A PDF download is currently unavailable.</p>}
  </header>
  <section class="section section-grid" aria-labelledby="experience-heading">
    <div><p class="eyebrow">Experience</p><h2 id="experience-heading">Software development and validation.</h2></div>
    <div class="prose resume-entry">
      <h3>{resume.experience.title} at {resume.experience.company}</h3>
      <p class="fine-print">{resume.experience.dates} · {resume.experience.location}</p>
      <ul>{resume.experience.responsibilities.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>
  <section class="section section-grid" aria-labelledby="education-heading">
    <div><p class="eyebrow">Education</p><h2 id="education-heading">Computer Science.</h2></div>
    <div class="prose resume-entry"><h3>{resume.education.school}</h3><p>{resume.education.degree}</p><p class="fine-print">{resume.education.dates} · Expected graduation: {resume.education.expectedGraduation}</p></div>
  </section>
  <section class="section section-grid" aria-labelledby="skills-heading">
    <div><p class="eyebrow">Technical skills</p><h2 id="skills-heading">Development, testing, and delivery.</h2></div>
    <div class="prose resume-entry">{resume.skills.map((group) => <div><h3>{group.category}</h3><p>{group.items.join(', ')}</p></div>)}</div>
  </section>
  <section class="section section-grid" aria-labelledby="project-heading">
    <div><p class="eyebrow">Project overview</p><h2 id="project-heading">{resume.project.title}</h2></div>
    <div class="prose"><p class="fine-print">{resume.project.dates}</p><p>{resume.project.summary}</p></div>
  </section>
  <section class="section section-grid" aria-labelledby="contact-heading">
    <div><p class="eyebrow">Languages and contact</p><h2 id="contact-heading">Get in touch.</h2></div>
    <div class="prose"><p>Languages: {resume.languages.join(', ')}.</p><p><a class="text-link" href={`mailto:${resume.email}`}>{resume.email}</a></p></div>
  </section>
</BaseLayout>
