---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { resume } from '../config/resume';
---

<BaseLayout title="About" description="Meet Isac Zarate, Backend Engineer / SDET, VivoSense Engineering Intern, and Computer Science student at CSU Channel Islands." pathname="/about/">
  <header class="page-intro"><p class="eyebrow">About</p><h1>Backend Engineer <em>/ SDET</em></h1><p class="lede">I’m Isac Zarate, also known as TheDevIsacZ. I work on application code, software testing, and validation.</p></header>
  <section class="section section-grid">
    <div><p class="eyebrow">My background</p><h2>Learning through code and testing.</h2></div>
    <div class="prose">
      <p>I’m an {resume.experience.title} at {resume.experience.company}, where I contribute to application updates, code review, software validation, testing, and documentation.</p>
      <p class="fine-print">{resume.experience.dates} · {resume.experience.location}</p>
      <p>I’m pursuing a {resume.education.degree} at {resume.education.school}, with graduation expected in {resume.education.expectedGraduation}.</p>
      <h2>Development and software quality</h2>
      <p>My skills include Java and Python, full-stack development, REST API development, and data pipelines. I also work with Selenium, API testing tools, functional and regression testing, GitHub Actions, and AWS services including S3 and DynamoDB.</p>
      <p>I value clear technical documentation and code that is readable and maintainable. I’m interested in roles where I can contribute to both implementation and testing.</p>
      <p><a class="text-link" href="/resume/">Read my résumé <span aria-hidden="true">→</span></a></p>
      {siteConfig.github && <p><a class="text-link" href={siteConfig.github} rel="me">Review the source on GitHub <span aria-hidden="true">→</span></a></p>}
      {siteConfig.email && <p><a class="text-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>}
    </div>
  </section>
</BaseLayout>
