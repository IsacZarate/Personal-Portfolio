{
  "name": "isac-zarate-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsx scripts/check-content.ts --source-only && astro build && tsx scripts/check-content.ts --require-build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:install": "playwright install chromium",
    "test:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:all": "pnpm check && pnpm test && pnpm build && pnpm test:e2e",
    "lint:content": "tsx scripts/check-content.ts",
    "infra:test": "vitest run infra/tests",
    "infra:synth": "cdk synth --app \"pnpm exec tsx infra/app.ts\" --lookups=false -c validation=true --quiet",
    "infra:diff": "cdk diff --app \"pnpm exec tsx infra/app.ts\"",
    "infra:deploy": "cdk deploy --app \"pnpm exec tsx infra/app.ts\"",
    "openspec:validate": "openspec validate --all --strict",
    "validate": "pnpm openspec:validate && pnpm lint:content && pnpm check && pnpm test && pnpm build && pnpm test:e2e && pnpm test:lighthouse && pnpm infra:synth"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fission-ai/openspec": "1.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "aws-cdk": "2.1144.0",
    "aws-cdk-lib": "2.272.0",
    "commander": "15.0.0",
    "constructs": "10.8.1",
    "jsdom": "30.1.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
